# Copy this file to .env for local development.
# Docker Compose services should use the postgres hostname below.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/purrfect_match

POSTGRES_DB=purrfect_match
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET_KEY=change-this-secret-key-to-at-least-32-characters

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

PORT=5000
VITE_API_URL=http://localhost:5000/api/v1

PGADMIN_DEFAULT_EMAIL=admin@purrfectmatch.dev
PGADMIN_DEFAULT_PASSWORD=change-me

# Non-Docker local backend:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/purrfect_match
