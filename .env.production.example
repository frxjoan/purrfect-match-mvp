# Copy to .env.production for a deployment rehearsal. Never commit real values.
COMPOSE_PROJECT_NAME=purrfect-match-rehearsal
POSTGRES_DB=purrfect_match
POSTGRES_USER=purrfect_match
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://purrfect_match:replace-with-a-long-random-password@postgres:5432/purrfect_match

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
RATELIMIT_STORAGE_URI=memory://

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

VITE_API_URL=https://api.example.com/api/v1
VITE_SITE_URL=https://app.example.com

FRONTEND_PORT=8080
BACKEND_PORT=5000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
